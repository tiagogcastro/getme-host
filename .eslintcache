           <h1>Aqui na <strong>ProVision</strong> é você que sai ganhando !!</h1>\r\n                        <h2>Nossa empresa tem o sistema de ativação automático após efetuar o pagamento. <br/> <strong> <AiOutlineDoubleRight /> Venha com a gente.</strong></h2>\r\n                    </div>\r\n                    <img src={Pay} alt=\"\"/>\r\n                </div>\r\n            </div>\r\n            <div className=\"location\">\r\n                <div className=\"maxWdLocation\">\r\n                    <h3>Escolha a localidade do seu servidor</h3>\r\n                    <div className=\"buttonsLocation\">\r\n                        <Location />\r\n                    </div>\r\n                </div>\r\n                <div className=\"bg\"></div>\r\n            </div>\r\n\r\n        </div>\r\n    )\r\n}","C:\\Users\\all\\Documents\\provisionhost\\src\\pages\\hosting\\ComponentsHostingpage.jsx",["64"],"C:\\Users\\all\\Documents\\provisionhost\\src\\pages\\components\\partesConfiguraveis\\pageHostSite.jsx",[],"C:\\Users\\all\\Documents\\provisionhost\\src\\pages\\components\\partesConfiguraveis\\pageServerCloudSite.jsx",[],{"ruleId":"65","replacedBy":"66"},{"ruleId":"67","replacedBy":"68"},{"ruleId":"69","severity":1,"message":"70","line":9,"column":18,"nodeType":"71","messageId":"72","endLine":9,"endColumn":26},{"ruleId":"73","severity":1,"message":"74","line":9,"column":32,"nodeType":"71","messageId":"75","endLine":9,"endColumn":46},{"ruleId":"76","severity":1,"message":"77","line":47,"column":29,"nodeType":"78","endLine":47,"endColumn":61},{"ruleId":"76","severity":1,"message":"77","line":78,"column":33,"nodeType":"78","endLine":78,"endColumn":45},{"ruleId":"76","severity":1,"message":"77","line":79,"column":33,"nodeType":"78","endLine":79,"endColumn":45},{"ruleId":"76","severity":1,"message":"77","line":80,"column":33,"nodeType":"78","endLine":80,"endColumn":45},{"ruleId":"76","severity":1,"message":"77","line":88,"column":33,"nodeType":"78","endLine":88,"endCol