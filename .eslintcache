ments\\provisionhost\\src\\pages\\hosting\\Hostingpage.jsx",[],"C:\\Users\\all\\Documents\\provisionhost\\src\\pages\\servers\\Serverspage.jsx",["66"],"C:\\Users\\all\\Documents\\provisionhost\\src\\pages\\teamspeak\\TeamSpeakpage.jsx",[],"C:\\Users\\all\\Documents\\provisionhost\\src\\components\\footer\\Footer.jsx",["67","68","69"],"C:\\Users\\all\\Documents\\provisionhost\\src\\components\\Header\\Header.jsx",["70"],"import React, {useEffect} from 'react';\r\n\r\nimport {Link} from 'react-router-dom';\r\nimport './header.css';\r\n\r\nimport {FiMenu, FiLogIn} from 'react-icons/fi';\r\nimport {AiOutlineHome} from 'react-icons/ai';\r\nimport {BsCloudDownload} from 'react-icons/bs'\r\nimport {FaServer} from 'react-icons/fa';\r\nimport {AiFillPhone} from 'react-icons/ai'\r\n\r\nimport Logo from '../../images/logo.png'\r\n\r\nexport default function Header() {\r\n    useEffect(() => {\r\n        const menu = document.querySelector('#menu')\r\n        const header = document.querySelector('.header')\r\n        const getButtonMenuOpen = document.querySelector('.btnMenu_open')\r\n        const getButtonMenuClose = document.querySelector('.btnMenu_close')\r\n        const menu_items = document.querySelectorAll('.menu-item .menu-item-action')\r\n\r\n        getButtonMenuOpen.addEventListener('click', () => {\r\n            menu.classList.add('menu_open')\r\n        })  \r\n\r\n        getButtonMenuClose.addEventListener('click', () => {\r\n            menu.classList.remove('menu_open')\r\n        })\r\n\r\n        menu_items.forEach((item) => {\r\n            item.addEventListener('click', () => {\r\n                menu.classList.remove('menu_open')\r\n            })\r\n        })\r\n        \r\n        window.addEventListener('scroll', function () {\r\n            if (window.scrollY > 20) header.classList.add('menuScroll'); \r\n            else header.classList.remove('menuScroll');\r\n        });\r\n    }, [])\r\n    \r\n    return (\r\n        <header className=\"header\">\r\n            <div className=\"bgHeader\">\r\n                <Link to=\"/\">\r\n                    <img src={Logo} alt=\"\"/>\r\n                </Link>\r\n                <li\r\n                    className=\"btnMenu btnMenu_open\">\r\n                    <FiMenu className=\"buttonMenu\"/>\r\n                </li>\r\n                <ul id=\"menu\" className=\"menu\">\r\n                    <div className=\"navigation\">\r\n                        <div className=\"logoBtnMenu\">\r\n                            <div className=\"maxWd\">\r\n                                <div className=\"logo\">\r\n                                    <Link to=\"/\">\r\n                                        <img src={Logo} alt=\"\"/>\r\n                                    </Link>\r\n                                </div>\r\n                                <li className=\"btnMenu btnMenu_close\"><FiMenu className=\"buttonMenu\"/></li>\r\n                            </div>\r\n                        </div>\r\n                        <li className=\"menu-item\">\r\n                            <Link to=\"/\"\r\n                            className=\"menu-item-action\">\r\n                                <AiOutlineHome/> Home\r\n                            </Link>\r\n                        </li>\r\n                        <li className=\"menu-item\">\r\n                            <Link to=\"/hospedagem-de-sites\"\r\n                            className=\"menu-item-action\">\r\n                               <FaServer/> Hospedagem de sites\r\n                            </Link>\r\n                        </li>\r\n                        <li className=\"menu-item\">\r\n                            <Link to=\"/servidor-cloud\" \r\n                            className=\"menu-item-action\">\r\n                               <BsCloudDownload/> Servidor Vps\r\n                            </Link>\r\n                        </li>\r\n                        <li className=\"menu-item\">\r\n                            <Link to=\"/teamSpeak\" \r\n                            className=\"menu-item-action\">\r\n                               <AiFillPhone/> TeamSpeak\r\n                            </Link>\r\n                        </li>\r\n                        <li className=\"menu-item login\">\r\n                            <a target=\"_blank\" href=\"https://financeiro.provision.gg/index.php?rp=/login\" \r\n                            className=\"menu-item-action\">\r\n                               <FiLogIn/> Login\r\n                            </a>\r\n                        </li>\r\n                    </div>\r\n                </ul>\r\n            </div>\r\n        </header>\r\n    )\r\n}\r\n\r\n","C:\\Users\\all\\Documents\\provisionhost\\src\\components\\partesConfiguraveis\\pageTeamSpeak.jsx",["71"],"C:\\Users\\all\\Documents\\provisionhost\\src\\components\\partesConfiguraveis\\pageServerCloudSite.jsx",[],"C:\\Users\\all\\Documents\\provisionhost\\src\\components\\partesConfiguraveis\\pageHostSite.jsx",["72"],"C:\\Users\\all\\Documents\\provisionhost\\src\\components\\AllConfigCardsOther\\index.jsx",[],{"ruleId":"73","replacedBy":"74"},{"ruleId":"75","replacedBy":"76"},{"ruleId":"77","severity":1,"message":"78","line":9,"column":16,"nodeType":"79","messageId":"80","endLine":9,"endColumn":24},{"ruleId":"81","severity":1,"message":"82","line":9,"column":30,"nodeType":"79","messageId":"83","endLine":9,"endColumn":44},{"ruleId":"84","severity":1,"message":"85","line":73,"column":29,"nodeType":"86","endLine":73,"endColumn":41},{"ruleId":"84","severity":1,"message":"85","line":74,"column":29,"nodeType":"86","endLine":74,"endColumn":41},{"ruleId":"84","severity":1,"message":"85","line":75,"column":29,"nodeType":"86","endLine":75,"endColumn":41},{"ruleId":"84","severity":1,"message":"85","line":83,"column":29,"nodeType":"86","endLine":83,"endColumn":41},{"ruleId":"84","severity":1,"message":"85","line":84,"column":29,"nodeType":"86","endLine":84,