visionhost\\src\\App.jsx",[],"C:\\Users\\all\\Documents\\provisionhost\\src\\Routes\\Router.js",[],"C:\\Users\\all\\Documents\\provisionhost\\src\\pages\\home\\Homepage.jsx",["61","62","63","64","65","66","67","68"],"import React from 'react';\r\nimport './homepage.css'\r\nimport cloudHome from '../.././images/svgsBg/cloudHome.svg'\r\nimport rocket from '../.././images/svgsBg/rocket.svg'\r\n\r\nimport ondas from '../.././images/svgsBg/ondas.svg'\r\n\r\nfunction chat() {\r\n    var Tawk_API=Tawk_API||{}, Tawk_LoadStart=new Date();\r\n    (\r\n        function(){\r\n            var s1=document.createElement(\"script\"),s0=document.getElementsByTagName(\"script\")[0];\r\n            s1.async=true;\r\n            s1.src='https://embed.tawk.to/5fcfd47aa1d54c18d8f1b449/default';\r\n            s1.charset='UTF-8';\r\n            s1.setAttribute('crossorigin','*');\r\n            s0.parentNode.insertBefore(s1,s0);\r\n    })();\r\n}\r\n\r\nexport default function HomePage() {\r\n    return (\r\n        <div className=\"home\">\r\n            <main className=\"main\">\r\n                <div className=\"main-content\">\r\n                    <div className=\"container\"> \r\n                        <div className=\"main-content\">\r\n                            <h1>Hospede seu site com qualidade.<br/> Venha com a <strong className=\"strongProvision\">ProVision.</strong></h1>\r\n                            <p>\r\n                            Já somos mais de 100.000 servidores vendidos. Lorem ipsum dolor sit amet, consectetur adipisicing elit.\r\n                            </p>\r\n                        </div>\r\n                        <img src={cloudHome} alt=\"\"/>\r\n                    </div>\r\n                </div>\r\n            </main>\r\n            \r\n            <section id=\"features\">\r\n                <div className=\"container\">\r\n                    <div className=\"contFeat\">\r\n                        <div\r\n                        className=\"features-container-content\">\r\n                            <h1>Serviços completos para todas indústrias.</h1>\r\n                            <p className=\"lead\">\r\n                                De projetos pequenos que necessitam de melhor custo/benefício, à projetos grandes que necessitam de maior performance e confiabilidade, nós temos a solução ideal para o seu projeto!\r\n                            </p>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <img src={ondas} alt=\"\" className=\"toBottom \" />\r\n            </section>\r\n            <section className=\"quality\">\r\n                <div className=\"allQualitys\">\r\n                    <div className=\"divQuality\">\r\n                        <h1>Por que você deve escolher a <strong className=\"strongProvision\">ProVision</strong> para hospedagem?</h1>\r\n                        <img src={rocket} alt=\"\"/>\r\n                    </div>\r\n                    <div className=\"myTextsQuality\">\r\n                        <div className=\"texts\">\r\n                            <h1>Facilidade</h1>\r\n                            <strong>Depois poem algum texto top aqui</strong>\r\n                            <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit. Quibusdam voluptates beatae eligendi id perspiciatis a voluptatum optio? Debitis maxime accusamus facilis aut, obcaecati laudantium numquam quaerat dolor harum mollitia. Ab.</p>\r\n                        </div>\r\n                        <div className=\"texts\">\r\n                            <h1>Segurança</h1>\r\n                            <strong>Proteção 24h para sua hospedagem</strong>\r\n                            <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit. Quibusdam voluptates beatae eligendi id perspiciatis a voluptatum optio? Debitis maxime accusamus facilis aut, obcaecati laudantium numquam quaerat dolor harum mollitia. Ab.</p>\r\n                        </div>\r\n                        <div className=\"texts\">\r\n                            <h1>Velocidade</h1>\r\n                            <strong>Processadores da melhor qualidade no mercado</strong>\r\n                            <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit. Quibusdam voluptates beatae eligendi id perspiciatis a voluptatum optio? Debitis maxime accusamus facilis aut, obcaecati laudantium numquam quaerat dolor harum mollitia. Ab.</p>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </section>\r\n            <section className=\"newFeature\">\r\n                <div className=\"features-content\">\r\n                    <div className=\"myFeatures\">\r\n                    <div className=\"content\">\r\n                        <img src=\"https://www.virtushost.net/pt/images/tour-3.png\" alt=\"\"/>\r\n                        <h1>Soluções para Projetos Menores</h1>\r\n                        <p>Serviços na nuvem com recursos totalmente dedicados e isolados, <strong>excelente performance e garantia de estabilidade!</strong>Ideal para aplicações mais pesadas.\r\n                        </p>\r\n                        <div className=\"features-links\">\r\n                            <a href=\"#\">&gt; Hospedagem de Sites</a>\r\n                            <a href=\"#\">&gt; Servidor Cloud de Alta Perfomace</a>\r\n                            <a href=\"#\">&gt; Datacenter Virtual</a>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"content\">\r\n                        <img src=\"https://www.virtushost.net/pt/images/tour-4.png\" alt=\"\"/>\r\n                        <h1>Soluções para Projetos Menores</h1>\r\n                        <p>Serviços na nuvem com recursos garantidos, totalmente escaláveis, que <strong>permitem a expansão conforme o seu projeto cresce</strong>, e que possuem um ótimo custo/benefício.</p>\r\n                        <div className=\"features-links\">\r\n                            <a href=\"#\">&gt; Hospedagem de Sites</a>\r\n                            <a href=\"#\">&gt; Servidor Cloud Escalável</a>\r\n                            <a href=\"#\">&gt; Hospedagens de Jogos</a>\r\n                        </div>\r\n                    </div>\r\n                    </div>\r\n                </div>\r\n            </section>\r\n            {chat()}\r\n        </div>\r\n\r\n    )\r\n}","C:\\Users\\all\\Documents\\provisionhost\\src\\pages\\components\\footer\\Footer.jsx",["69","70","71"],"import React from 'react';\r\nimport './footer.css';\r\nimport cloudFooter2 from '../../../images/svgsBg/cloudFooter2.svg';\r\n\r\nconst date = new Date();\r\nconst year = date.getFullYear();\r\n\r\nexport default function Footer() {\r\n    return (\r\n    <section className=\"footer\">\r\n        <div className=\"endSiteFooter\">\r\n            <img src={cloudFooter2} alt=\"\"/> \r\n            <div className=\"container-text\">\r\n                <h1>Tudo o que você precisa para revolucionar sua hospedagem</h1>\r\n                <p>Fale com nossos especialistas e descubra a solução perfeita para atender as demandas do seu projeto.</p>\r\n            </div>   \r\n        </div>\r\n        <footer className=\"footerEnd\">\r\n            <div className=\"legal\">\r\n                {/* Usar <a href=\"https://...\"> Nome </a> Tira a class buttonLock para deixar o cursor: pointer !!*/}\r\n                <a className=\"buttonLock\">Informações Legais</a>\r\n                <a className=\"buttonLock\">Termos de Serviço</a>\r\n                <a className=\"buttonLock\">Política de Utilização Aceitável</a>\r\n            </div>\r\n            <div className=\"container-footer\">\r\n                <div className=\"footer-texts\">\r\n                    <h5>Reembolso Garantido</h5>\r\n                    <p>7 dias de moneyback garantido.</p>\r\n                </div>\r\n                <div className=\"footer-texts\">\r\n                    <h5>Suporte 5 Estrelas</h5>\r\n                    <p>Converse conosco via Livechat.</p>\r\n                </div>\r\n                <div className=\"footer-texts\">\r\n                    <h5>Sem fidelidade</h5>\r\n                    <p>Cancele quando quiser.</p>\r\n                </div>\r\n                <div className=\"footer-texts\">\r\n                    <h5>Serviços Pré-pagos</h5>\r\n                    <p>Pague apenas quando quiser.</p>\r\n                </div>\r\n            </div>\r\n            \r\n            <div className=\"copyright\">\r\n                <p>&copy; Copyright - {year} <strong>❤️ ProVision</strong></p> \r\n                <div className=\"pay\">\r\n                    <img src=\"https://www.virtushost.net/images/payments.png\" alt=\"\"/>\r\n                </div>\r\n            </div>\r\n        </footer>\r\n    </section>\r\n    )\r\n}","C:\\Users\\all\\Documents\\provisionhost\\src\\pages\\components\\Header\\Header.jsx",["72"],"import React, {useEffect} from 'react';\r\n\r\nimport {Link} from 'react-router-dom';\r\nimport './header.css';\r\n\r\nimport {FiMenu, FiLogIn} from 'react-icons/fi';\r\nimport {AiOutlineHome} from 'react-icons/ai';\r\nimport {BsCloudDownload} from 'react-icons/bs'\r\nimport {FaServer} from 'react-icons/fa';\r\nimport {AiFillPhone} from 'react-icons/ai'\r\n\r\nimport Logo from '../../../images/logo.png'\r\n\r\nexport default function Header() {\r\n    useEffect(() => {\r\n        const menu = document.querySelector('#menu')\r\n        const header = document.querySelector('.header')\r\n        const getButtonMenuOpen = document.querySelector('.btnMenu_open')\r\n        const getButtonMenuClose = document.querySelector('.btnMenu_close')\r\n        const menu_items = document.querySelectorAll('.menu-item .menu-item-action')\r\n\r\n        getButtonMenuOpen.addEventListener('click', () => {\r\n            menu.classList.add('menu_open')\r\n        })  \r\n\r\n        getButtonMenuClose.addEventListener('click', () => {\r\n            menu.classList.remove('menu_open')\r\n        })\r\n\r\n        menu_items.forEach((item) => {\r\n            item.addEventListener('click', () => {\r\n                menu.classList.remove('menu_open')\r\n            })\r\n        })\r\n        \r\n        window.addEventListener('scroll', function () {\r\n            if (window.scrollY > 20) header.classList.add('menuScroll'); \r\n            else header.classList.remove('menuScroll');\r\n        });\r\n    }, [])\r\n    \r\n    return (\r\n        <header className=\"header\">\r\n            <div className=\"bgHeader\">\r\n                <Link to=\"/\">\r\n                    <img src={Logo} alt=\"\"/>\r\n                </Link>\r\n                <li\r\n                    className=\"btnMenu btnMenu_open\">\r\n                    <FiMenu className=\"buttonMenu\"/>\r\n                </li>\r\n                <ul id=\"menu\" className=\"menu\">\r\n                    <div className=\"navigation\">\r\n                        <div className=\"logoBtnMenu\">\r\n                            <div className=\"maxWd\">\r\n                                <div className=\"logo\">\r\n                                    <Link to=\"/\">\r\n                                        <img src={Logo} alt=\"\"/>\r\n                                    </Link>\r\n                                </div>\r\n                                <li className=\"btnMenu btnMenu_close\"><FiMenu className=\"buttonMenu\"/></li>\r\n                            </div>\r\n                        </div>\r\n                        <li className=\"menu-item\">\r\n                            <Link to=\"/\"\r\n                            className=\"menu-item-action\">\r\n                                <AiOutlineHome/> Home\r\n                            </Link>\r\n                        </li>\r\n                        <li className=\"menu-item\">\r\n                            <Link to=\"/hospedagem-de-sites\"\r\n                            className=\"menu-item-action\">\r\n                               <FaServer/> Hospedagem de sites\r\n                            </Link>\r\n                        </li>\r\n                        <li className=\"menu-item\">\r\n                            <Link to=\"/servidor-cloud\" \r\n                            className=\"menu-item-action\">\r\n                               <BsCloudDownload/> Servidor Cloud/Vps\r\n                            </Link>\r\n                        </li>\r\n                        <li className=\"menu-item\">\r\n                            <Link to=\"/teamSpeak\" \r\n                            className=\"menu-item-action\">\r\n                               <AiFillPhone/> TeamSpeak\r\n                            </Link>\r\n                        </li>\r\n                        <li className=\"menu-item login\">\r\n                            <a target=\"_blank\" href=\"https://financeiro.provision.gg/index.php?rp=/login\" \r\n                            className=\"menu-item-action\">\r\n                               <FiLogIn/> Login\r\n                            </a>\r\n                        </li>\r\n                    </div>\r\n                </ul>\r\n            </div>\r\n        </header>\r\n    )\r\n}\r\n\r\n","C:\\Users\\all\\Documents\\provisionhost\\src\\pages\\hosting\\Hostingpage.jsx",[],"C:\\Users\\all\\Documents\\provisionhost\\src\\pages\\servers\\Serverspage.jsx",["73"],"import React from 'react';\r\n\r\nexport default function Serverspage() {\r\n    return (\r\n        <div id=\"page\">\r\n            <h1>Servidor Cloud totalmente escalável</h1>\r\n        </div>\r\n    )\r\n}","C:\\Users\\all\\Documents\\provisionhost\\src\\pages\\hosting\\ComponentsHostingpage.jsx",["74"],"C:\\Users\\all\\Documents\\provisionhost\\src\\pages\\components\\partesConfiguraveis\\pageHostSite.jsx",[],"C:\\Users\\all\\Documents\\provisionhost\\src\\pages\\comp